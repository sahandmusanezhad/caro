# The worker's settings (docs/PHASE3_SETUP.md): on the machine it runs on --
# the owner's own today -- and on no other. Copy this file there, fill it
# there, mode 600. Nothing in it is ever committed, pasted into a
# conversation, or sent anywhere.
#
#   docker compose -p caro-worker --env-file <this file> -f compose.worker.yml up -d

# The file's own path, and the image: the API's, which carries the worker.
CARO_WORKER_ENV_FILE=/etc/caro/worker.env
CARO_API_IMAGE=ghcr.io/sahandmusanezhad/caro-api:production

# The queue's own database password, made here: openssl rand -hex 24
CARO_QUEUE_PASSWORD=

# first_run's salt: the one the owner's runs already use, so that a seller
# is hashed as before. It lives here and in no other place.
CARO_SELLER_SALT=

# The runs, each `HH:MM <first_run's arguments>` in Tehran, `;` between two.
CARO_COLLECT=03:30 --source khodro45 --pages 60

# The server the records go to, and the token it knows this worker by (the
# server's CARO_WORKER_TOKEN). Both empty, the records stay here.
CARO_INGEST_URL=https://caro.noxioai.com
CARO_WORKER_TOKEN=

# The private bucket (caro/bucket.py), an R2 token for this bucket only.
# All four empty, a run's files stay on this machine alone.
CARO_BUCKET_ENDPOINT=
CARO_BUCKET_NAME=
CARO_BUCKET_KEY_ID=
CARO_BUCKET_SECRET=

# A name for this worker in the records; empty, the host's and the process's.
CARO_WORKER_NAME=
