# /etc/caro/production.env -- and staging.env beside it -- one environment's
# settings on the server (docs/PHASE1_SETUP.md). Copy this file there, fill
# it on the server, and keep it there: mode 600, owned by root. Nothing in it
# is ever committed, pasted into a conversation, or sent anywhere.

# Which environment this is, and the file's own path: compose reads the file
# for its variables, and hands it to the API's container as its environment.
CARO_ENV=production
CARO_ENV_FILE=/etc/caro/production.env

# The images, by the tag the workflow moves for this environment: :staging
# on every merge into main, :production on every release tag.
CARO_API_IMAGE=ghcr.io/sahandmusanezhad/caro-api:production
CARO_SITE_IMAGE=ghcr.io/sahandmusanezhad/caro-site:production

# This environment's own database password, made on the server:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# The operator's view (webapp/README.md). Unset, /admin opens for nobody.
CARO_ADMIN_TOKEN=
CARO_ADMIN_TOTP_SECRET=
CARO_INBOX=off

# Error reports to Sentry (PHASE0_SETUP, step 2). Unset, they are off.
SENTRY_DSN=

# Seller listings (docs/PHASE2_SETUP.md). Off while CARO_SELLER_STORE is
# empty. On, the store lives in this environment's Postgres, beside the
# catalog; its secret is made on the server (openssl rand -hex 32); the
# origin is the one the site is served from; and the provider is the SMS
# account's (webapp/api/sms.py). The site's links to them are the images'
# build setting NEXT_PUBLIC_SELLER_LISTINGS, a GitHub variable.
CARO_SELLER_STORE=
CARO_STORE_SECRET=
CARO_SITE_ORIGINS=https://caro.noxioai.com
CARO_SMS_PROVIDER=
CARO_SMS_KAVENEGAR_KEY=
CARO_SMS_KAVENEGAR_TEMPLATE=
CARO_SMS_KAVENEGAR_SENDER=

# The collection's records and alerts (docs/PHASE3_SETUP.md). The worker
# reports each run to /api/worker/runs by this token, made on the server
# (openssl rand -hex 32) and typed into the worker's own file; unset, the
# records are off. The alerts say a run that did not arrive by its time
# (source@HH:MM, Tehran), and go to Telegram where the bot is named.
CARO_WORKER_TOKEN=
CARO_ALERT_EXPECT=
CARO_ALERT_TELEGRAM_TOKEN=
CARO_ALERT_TELEGRAM_CHAT=

# What Cloudflare keeps of the API's answers (docs/PHASE4_SETUP.md): three
# GETs, for CARO_EDGE_TTL seconds (300 when empty), purged after a deploy
# that changed the runs. The token is Cloudflare's, with Zone -> Cache Purge
# on this zone only; without it, nothing is purged.
CARO_SITE_HOST=caro.noxioai.com
CARO_EDGE_TTL=
CARO_CF_API_TOKEN=
CARO_CF_ZONE_ID=

# Turnstile's secret key (docs/PHASE4_SETUP.md, step 3): set only after the
# site that draws the widget is deployed, or every code request is refused.
CARO_TURNSTILE_SECRET=

# What the API counts, written to Grafana Cloud (docs/PHASE7_SETUP.md). With
# COMPOSE_PROFILES=observe, the `observe` service reads /metrics on this
# environment's own network every 30 s and writes it to the stack's
# Prometheus: its remote-write address, its user (the instance's number) and
# an access policy's token with metrics:write alone. Empty, nothing is sent.
COMPOSE_PROFILES=
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_TOKEN=
